# SliDesk deploy configuration
# Copy this file outside the web root and set ENV_FILE in deploy.php accordingly.
# Never commit the real .env to the repository.

BIN_PATH=/home/you
SOURCE_PATH=/home/you/slidesk-demo
DEST_PATH=/home/you/www/slides
BUILD_PATH=/tmp/slidesk-build
DEPLOY_TOKEN=change-me
# LOG_FILE=/tmp/slidesk-deploy.log

# Keypad values injected into the generated slidesk.js (overriding slidesk.toml).
# The deck fetches `${API_URL}/pad/<endpoint>` and authenticates with ADMIN_PASSWORD.
ADMIN_PASSWORD=change-me-too
API_URL=/
